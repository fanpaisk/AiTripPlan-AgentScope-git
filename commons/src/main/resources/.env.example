# ============================================================
#  AiTripPlan 环境变量模板
#  复制本文件为 .env 并填入自己的密钥
#    Windows: copy .env.example .env
#    macOS/Linux: cp .env.example .env
#
#  ★ 语言模型是「厂商中立」的：改下面 3 行就能换厂商，代码零改动
# ============================================================

# ---- 语言模型 ----
LLM_PROVIDER=openai-compatible
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-v4-flash
LLM_API_KEY=sk-你的APIKey

# 常见厂商配置参考：
#   DeepSeek 官方 : LLM_BASE_URL=https://api.deepseek.com          LLM_MODEL=deepseek-v4-flash
#   阿里云百炼    : LLM_BASE_URL=（留空即用兼容模式默认地址）        LLM_MODEL=qwen3-max
#   Kimi 官方     : LLM_BASE_URL=https://api.moonshot.cn/v1        LLM_MODEL=moonshot-v1-8k
#   SiliconFlow   : LLM_BASE_URL=https://api.siliconflow.cn/v1     LLM_MODEL=<模型名>
#   本地 Ollama   : LLM_BASE_URL=http://127.0.0.1:11434/v1         LLM_MODEL=qwen2.5

# ---- 其它依赖 ----
# 百度地图 MCP Server 的 SSE 地址（必须是 https:// 开头的完整地址）
BAIDU_MAP_MCP_SSE_URL=https://mcp.api-inference.modelscope.net/你的实例ID/sse

NACOS_SERVER_ADDR=127.0.0.1:8848

# ---- 观测（可选）AgentScope → Langfuse ----
# 用途：把每次 LLM / 工具 / Agent 调用以 OpenTelemetry span 上报，
#       用于做「单 Agent vs 多 Agent」这类对照实验（耗时、token、成本、失败率）。
# 【整个观测功能是可选的】：下面两个 Key 留空时，服务只打一条警告并跳过上报，
#   业务接口与 /api/health 完全正常 —— 所以不做观测的话保持留空即可。
# Key 获取：Langfuse Cloud → 项目 → Settings → API Keys
# ⚠️ 上报内容包含 prompt、工具参数与模型输出（境外服务），不想外传就设为 false
LANGFUSE_TRACING_ENABLED=true
LANGFUSE_OTLP_ENDPOINT=https://cloud.langfuse.com/api/public/otel/v1/traces
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
